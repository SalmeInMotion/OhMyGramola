{
  "name": "ohmygramola",
  "extensionId": "com.salmeinmotion.free-royalties-music",
  "version": "1.1.0",
  "description": "OhMyGramola — Royalty-free & Creative Commons music browser, live waveform trimmer, and one-click importer for Adobe After Effects (CC 2020 - 2026+)",
  "main": "src/index.html",
  "scripts": {
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install.ps1 -Silent",
